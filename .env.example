# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-20b

# Agent Configuration
AGENT_MAX_STEPS=30
AGENT_STEP_DELAY_MS=1500
AGENT_ACTION_TIMEOUT_MS=5000

# ADB Configuration
# Set to "auto" to use the first connected device, or specify a device ID
ADB_DEVICE_ID=auto

# WebSocket Server
WS_PORT=4000
